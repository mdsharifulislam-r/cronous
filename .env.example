# =============================================================================
# Chronos server configuration. Copy to .env and adjust.
# Every variable is validated at startup; the server refuses to start on bad config.
# Generate secrets with:  openssl rand -hex 32   (hex keeps them URL-safe)
# =============================================================================

NODE_ENV=production
PORT=8080
LOG_LEVEL=info
# Human-readable logs for local development only (must be false in production).
LOG_PRETTY=false

# Prefix for every Redis key and BullMQ queue owned by Chronos. Lets Chronos share a
# Redis instance with your applications without collisions.
CHRONOS_NAMESPACE=chronos

# Optional. If unset, a one-time bootstrap token is generated on first start and
# printed to the server log. Either way it is only valid until POST /v1/bootstrap succeeds.
CHRONOS_BOOTSTRAP_TOKEN=

CHRONOS_USER_TOKEN_TTL_HOURS=12
CHRONOS_LOGIN_MAX_FAILURES=10
CHRONOS_LOGIN_LOCKOUT_SECONDS=900
# Enable only when a reverse proxy you control sets X-Forwarded-For.
CHRONOS_TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API (e.g. a dashboard).
CHRONOS_CORS_ORIGINS=

# --- Scheduling and execution (see docs/DEPLOYMENT_GUIDE.md) ----------------------
CHRONOS_EMBEDDED_SCHEDULER=true
CHRONOS_EMBEDDED_WORKER=true
CHRONOS_SCHEDULER_TICK_MS=1000
CHRONOS_LEASE_MS=30000
CHRONOS_WORKER_CONCURRENCY=10
CHRONOS_AGENT_HEARTBEAT_MS=10000
CHRONOS_EXECUTION_RETENTION_DAYS=30
# Webhook SSRF policy. Loopback and link-local (cloud metadata) are always blocked unless
# listed in CHRONOS_WEBHOOK_ALLOWED_CIDRS.
CHRONOS_WEBHOOK_ALLOW_PRIVATE=true
CHRONOS_WEBHOOK_ALLOWED_CIDRS=
CHRONOS_DASHBOARD_ENABLED=true
# Long-lived connections (agent WebSockets, dashboard event streams) re-validate their
# credential this often, so revocation disconnects them without waiting for a reconnect.
CHRONOS_CREDENTIAL_RECHECK_MS=30000
# API rate limits (per minute, shared by all replicas through Redis). Requests with a token
# are counted per token; without a token, per client IP. An IP that presents this many
# unknown tokens in a minute is refused outright. Behind a reverse proxy (or the Next.js
# dashboard) set CHRONOS_TRUST_PROXY=true so the real client IP is used.
CHRONOS_RATE_LIMIT_ENABLED=true
CHRONOS_RATE_LIMIT_PER_TOKEN_PER_MINUTE=1200
CHRONOS_RATE_LIMIT_ANONYMOUS_PER_MINUTE=120
CHRONOS_RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=30
# Dashboard real-time stream (GET /v1/projects/:id/events): change-feed poll interval
# (only runs while a stream is open) and the per-process stream limit.
CHRONOS_EVENTS_POLL_MS=1000
CHRONOS_EVENTS_MAX_STREAMS=500
CHRONOS_SHUTDOWN_TIMEOUT_MS=15000
CHRONOS_READINESS_TIMEOUT_MS=2000

# Optional central workers (compose --profile workers): directory + file with handlers.
CHRONOS_WORKER_HANDLERS_DIR=
CHRONOS_WORKER_HANDLERS_FILE=handlers.js
CHRONOS_WORKER_MODES=WORKER

# Where docker compose publishes the API. Keep 127.0.0.1 and put a TLS reverse proxy in
# front; use 0.0.0.0 only on a private network.
CHRONOS_HTTP_BIND=127.0.0.1
CHRONOS_HTTP_PORT=8080

# -----------------------------------------------------------------------------
# Scenario A: bundled PostgreSQL + Redis (docker/compose.yaml)
# DATABASE_URL and REDIS_URL are derived from these inside compose.
# -----------------------------------------------------------------------------
POSTGRES_USER=chronos
POSTGRES_DB=chronos
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-32
REDIS_PASSWORD=change-me-generate-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# Scenario B: existing infrastructure (docker/compose.external.yaml), or running the
# server directly with `pnpm dev`. Pick the line matching your topology.
# -----------------------------------------------------------------------------
# Same VPS, Postgres/Redis installed on the host (Linux: host.docker.internal needs
# `extra_hosts`, or use the docker0 bridge IP 172.17.0.1):
# DATABASE_URL=postgresql://chronos:PASSWORD@172.17.0.1:5432/chronos
# REDIS_URL=redis://:PASSWORD@172.17.0.1:6379/0
#
# Same Docker network as your existing containers (also set CHRONOS_EXTERNAL_NETWORK and
# add docker/compose.network.yaml):
# DATABASE_URL=postgresql://chronos:PASSWORD@my-postgres:5432/chronos
# REDIS_URL=redis://:PASSWORD@my-redis:6379/3
# CHRONOS_EXTERNAL_NETWORK=my_app_network
#
# Separate VPS over a private network / VPN, TLS-enabled Redis:
# DATABASE_URL=postgresql://chronos:PASSWORD@10.0.0.5:5432/chronos?sslmode=require
# REDIS_URL=rediss://:PASSWORD@10.0.0.6:6380/0
#
# Local development (`pnpm dev`) against `pnpm infra:test:up`:
# DATABASE_URL=postgresql://chronos:chronos@localhost:55432/chronos_dev
# REDIS_URL=redis://localhost:56379/1
DATABASE_URL=
REDIS_URL=
CHRONOS_EXTERNAL_NETWORK=

# -----------------------------------------------------------------------------
# Development seed only (`pnpm db:seed`; refuses to run with NODE_ENV=production)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
