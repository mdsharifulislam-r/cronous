{
  "name": "@chronos/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Chronos central worker (Mode C) and webhook delivery (Mode A). Runs on any host with access to PostgreSQL and Redis.",
  "main": "dist/main.js",
  "files": [
    "dist",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@chronos/database": "workspace:*",
    "@chronos/engine": "workspace:*",
    "@chronos/shared": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.6",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdsharifulislam-r/cronous.git",
    "directory": "apps/worker"
  },
  "homepage": "https://github.com/mdsharifulislam-r/cronous#readme",
  "bugs": {
    "url": "https://github.com/mdsharifulislam-r/cronous/issues"
  }
}
