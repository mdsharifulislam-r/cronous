{
  "name": "@chronos/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "nest start --watch --exec \"node --enable-source-maps --env-file-if-exists=../../.env\"",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@chronos/dashboard-lite": "workspace:*",
    "@chronos/database": "workspace:*",
    "@chronos/engine": "workspace:*",
    "@chronos/protocol": "workspace:*",
    "@chronos/shared": "workspace:*",
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/platform-express": "11.2.12",
    "bullmq": "5.81.6",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cronouss/cronous": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@swc/core": "1.13.21",
    "@types/express": "5.0.6",
    "@types/node": "22.20.6",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdsharifulislam-r/cronous.git",
    "directory": "apps/server"
  },
  "homepage": "https://github.com/mdsharifulislam-r/cronous#readme",
  "bugs": {
    "url": "https://github.com/mdsharifulislam-r/cronous/issues"
  }
}
