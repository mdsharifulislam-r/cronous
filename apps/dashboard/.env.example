# Chronos API base URL as seen from the dashboard SERVER (Next.js route handlers), without /v1.
# The browser never calls it directly, so it can be an internal address.
#   same Docker network: http://chronos-server-1:8080   local dev: http://127.0.0.1:8080
CHRONOS_API_URL=http://127.0.0.1:8080
# Public URL of the Chronos API for links/snippets shown in the UI (optional; display only).
NEXT_PUBLIC_CHRONOS_PUBLIC_URL=
# Mark session cookies Secure (set false only for http:// local development).
DASHBOARD_SECURE_COOKIES=false
