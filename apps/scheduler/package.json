{
  "name": "@chronos/scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Chronos scheduler (scheduling, dispatch, recovery). Optional: the server embeds the same loop by default.",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@chronos/database": "workspace:*",
    "@chronos/engine": "workspace:*",
    "@chronos/shared": "workspace:*",
    "bullmq": "5.81.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "pino-pretty": "13.2.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdsharifulislam-r/cronous.git",
    "directory": "apps/scheduler"
  },
  "homepage": "https://github.com/mdsharifulislam-r/cronous#readme",
  "bugs": {
    "url": "https://github.com/mdsharifulislam-r/cronous/issues"
  }
}
